# Copy to .env and fill in. Never commit .env.

# ── Database: Neon Postgres ───────────────────────────────────────────────
# DATABASE_URL = pooled connection string (used by the app and worker)
# DIRECT_URL   = direct (non-pooled) string, used by `prisma db push`
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# ── Queue: Upstash Redis (BullMQ). Must be a rediss:// URL (TLS) ──────────
REDIS_URL="rediss://default:PASSWORD@HOST.upstash.io:6379"

# ── Mock switch ───────────────────────────────────────────────────────────
# true  = PageSpeed, Search Console, DataForSEO, Claude, WhatsApp and email are all mocked
# false = real calls (see README: only PageSpeed and Claude have real implementations)
USE_MOCKS=true

# ── Claude (only used when USE_MOCKS=false) ───────────────────────────────
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-6

# ── Optional real integrations (only used when USE_MOCKS=false) ───────────
# PAGESPEED_API_KEY=
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=

# ── Auth + cron ───────────────────────────────────────────────────────────
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-string
CRON_SECRET=replace-with-a-long-random-string

# ── Reports ───────────────────────────────────────────────────────────────
# Folder the worker writes PDFs to (defaults to <OS temp dir>/reports)
# REPORTS_DIR=/tmp/reports

# ── Demo helpers (leave off in production) ────────────────────────────────
# Slows each worker step so the progress bar is watchable in a screen recording
# AUDIT_STEP_DELAY_MS=1500
# Shows "Admin demo / Client demo" quick-fill buttons on the login page
DEMO_LOGINS=false
